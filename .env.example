# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
DB_URL=jdbc:mysql://localhost:3306/fast_shop?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=12345678

# Khóa ký cookie đăng nhập (chuỗi ngẫu nhiên dài). Để trống thì mỗi lần khởi động sẽ đăng xuất mọi người.
APP_SECRET=

# Gmail dùng khi chạy ngoài Docker (App Password của Google)
GMAIL_USERNAME=
GMAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
